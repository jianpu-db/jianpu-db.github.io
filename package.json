{
  "name": "jianpu-web",
  "private": true,
  "type": "module",
  "description": "简谱旋律查歌 —— 前端 TypeScript（零运行时依赖的 ES module，esbuild 只做类型擦除）+ Cloudflare Workers / GitHub Pages 两条部署包装",
  "scripts": {
    "build": "node tools/build_dist.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "node tools/bench_search.mjs 40",
    "build:gh": "node tools/build_dist.mjs --target gh",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "bash tools/check_all.sh",
    "check:gh": "bash tools/check_gh_pages.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4"
  }
}
