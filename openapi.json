                  },
                  {
                    "$ref": "#/components/schemas/AttrReq"
                  },
                  {
                    "$ref": "#/components/schemas/ScoreReq"
                  }
                ],
                "title": "Body",
                "description": "按 `kind` 区分的四种投稿载荷",
                "discriminator": {
                  "propertyName": "kind",
                  "mapping": {
                    "link": "#/components/schemas/LinkReq",
                    "tags": "#/components/schemas/TagsReq",
                    "attr": "#/components/schemas/AttrReq",
                    "new": "#/components/schemas/ScoreReq",
                    "fix": "#/components/schemas/ScoreReq",
                    "meta": "#/components/schemas/ScoreReq"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
